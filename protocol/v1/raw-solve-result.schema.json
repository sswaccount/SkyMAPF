{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skymapf.org/protocol/v1/raw-solve-result.schema.json",
  "title": "SkyMAPF Raw Solve Result Protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "problem_id", "solver", "status", "paths"],
  "properties": {
    "protocol_version": {"const": "skymapf.raw-solve-result.v1"},
    "problem_id": {"type": "string", "minLength": 1},
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string"},
        "configuration": {"type": "object"}
      }
    },
    "status": {
      "enum": ["success", "infeasible", "timeout", "unsupported", "error"]
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "cells"],
        "properties": {
          "agent_id": {"type": "integer", "minimum": 1},
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "statistics": {"type": "object"},
    "message": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {"properties": {"paths": {"minItems": 1}}},
      "else": {"properties": {"paths": {"maxItems": 0}}}
    }
  ]
}
